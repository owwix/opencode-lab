# Copy to opencode.env. This file is ignored by Git.
# The token needs Cloudflare Workers AI permission for this account. The default
# standard lane uses GPT-OSS 120B; frontier Kimi K2.6/K2.7 and GLM-5.2 routes
# require Workers Paid or eligible prepaid AI Gateway credits. The launcher
# exposes these values only to the fixed-purpose agent gateway, never to the
# OpenCode process or mounted workspace.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Enables the allowlisted OpenAI chat models through the credential
# gateway. The key is never injected into OpenCode or the mounted workspace.
OPENAI_API_KEY=

# Optional. Enables Gemini 3.7 Flash and Gemini 3.1 Pro in the Lab picker
# through Vertex AI. Uses Application Default Credentials on this Mac; the
# OpenCode container never receives the Google refresh token.
GOOGLE_CLOUD_PROJECT=light-result-504202-m9

# Generated automatically when omitted and stored in this mode-0600 file.
# The gateway keeps this signing authority. OpenCode receives only a signed,
# short-lived, workspace-bound capability lease created for each launch.
AGENT_GATEWAY_SIGNING_KEY=

# Optional separate host-only signer for strict-mode export bundles. When
# omitted, strict export uses AGENT_GATEWAY_SIGNING_KEY. Neither key enters the
# strict sandbox.
STRICT_EXPORT_SIGNING_KEY=

# Required only for strict-mode sessions. Use the HTTPS URL of a fixed-purpose
# gateway that accepts the short-lived capability issued by this host.
STRICT_GATEWAY_URL=

# Generated automatically by the launcher when omitted. It protects the local
# OpenDesign API shared by the OpenCode and OpenDesign containers.
OD_API_TOKEN=

# Generated automatically for the loopback-only quality service. The agent
# gateway injects it upstream, so OpenCode never receives the real value.
QUALITY_MCP_TOKEN=

# Generated automatically for the loopback-only GitHub publishing and OpenPets
# relays. These credentials authenticate only gateway-to-relay traffic; the
# relays also require the current signed workspace/run lease and are restarted
# for each selected workspace.
GITHUB_PUBLISH_RELAY_TOKEN=
OPENPETS_RELAY_TOKEN=
LAB_BROWSER_VERIFY_RELAY_TOKEN=
LAB_BROWSER_SESSION_RELAY_TOKEN=

# Optional HTTPS artifact relay. List exact public hostnames separated by
# commas. Direct OpenCode egress remains disabled.
ARTIFACT_DOWNLOAD_ALLOWLIST=

# Optional. Host loopback ports for app servers the agent starts in /workspace.
# Defaults are 3100 -> container 3000 and 3101 -> container 3001.
# OPENCODE_PREVIEW_PORT=3100
# OPENCODE_PREVIEW_PORT_ALT=3101

# Optional restricted Notion publisher. Create an internal Notion connection
# with Insert content only, share only the target parent pages, then set a JSON
# map such as {"research":"<page-id>"}. Start it with
# npm run opencode:notion; OpenCode itself never receives this API token.
NOTION_API_TOKEN=
NOTION_PUBLISH_TARGETS_JSON=
NOTION_PUBLISHER_TOKEN=
# Optional versioned workflow packs. Use the host path delimiter (`:` on
# macOS/Linux) for multiple absolute pack directories. Pack paths stay on host.
OPENCODE_LAB_PACKS=
