{
  "name": "opencode-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Personal OpenCode Lab harness — Docker-isolated coding TUI with gateway, preview, and managed quality runs",
  "keywords": [
    "agents",
    "docker",
    "lab",
    "opencode"
  ],
  "license": "Apache-2.0",
  "bin": {
    "lab": "scripts/opencode-entry.mjs",
    "opencode-lab": "scripts/opencode-entry.mjs"
  },
  "type": "module",
  "scripts": {
    "test:hound": "node --test scripts/hound-relay.test.mjs scripts/hound-config.test.mjs",
    "test:opencode-preview": "node --test docker/opencode-preview/server.test.mjs",
    "test:lab": "node --test scripts/lab/*.test.mjs scripts/opencode-tui-merge.test.mjs scripts/opencode-preferences.test.mjs scripts/opencode-routing.test.mjs",
    "preview:ensure": "node scripts/local-preview/ensure.mjs",
    "preview:check": "node scripts/local-preview/check.mjs",
    "lab:checkpoint": "node scripts/lab/checkpoint.mjs",
    "lab:browser": "node scripts/lab/browser-verify.mjs",
    "lab:browser:setup": "npm install playwright@1.55.0 --no-save && npx playwright install chromium",
    "lab:browser:relay": "node scripts/lab/browser-verify-relay.mjs",
    "lab:browser:session": "node scripts/lab/browser-session-relay.mjs",
    "lab:background": "node scripts/lab/background-ship.mjs",
    "lab:fleet": "node scripts/lab/fleet.mjs",
    "opencode": "node scripts/opencode.mjs",
    "opencode:setup": "node scripts/opencode-setup.mjs",
    "opencode:task": "node scripts/opencode.mjs task",
    "opencode:pick": "node scripts/opencode.mjs",
    "opencode:auto": "node scripts/opencode.mjs --auto",
    "opencode:acp": "node scripts/opencode.mjs acp",
    "opencode:notion": "node scripts/opencode.mjs notion:start",
    "agent:quality": "node scripts/quality-controller.mjs run",
    "ship": "node scripts/managed-task.mjs ship",
    "research": "node scripts/managed-task.mjs research",
    "quality:status": "node scripts/quality-controller.mjs status",
    "quality:controller": "node scripts/quality-controller.mjs",
    "quality:routes": "node scripts/quality/model-registry.mjs",
    "cloudflare:ai-gateway": "node scripts/cloudflare/apply-ai-gateway.mjs",
    "quality:metrics": "node scripts/quality-controller.mjs metrics",
    "quality:alerts": "node scripts/quality-alerts.mjs --check",
    "doctor": "node scripts/agent-doctor.mjs",
    "quality:resume": "node scripts/quality-controller.mjs resume",
    "quality:cancel": "node scripts/quality-controller.mjs cancel",
    "quality:abandon": "node scripts/quality-controller.mjs abandon",
    "quality:artifacts": "node scripts/quality-controller.mjs artifacts",
    "quality:archive": "node scripts/quality-controller.mjs archive",
    "quality:cleanup": "node scripts/quality-controller.mjs cleanup",
    "quality:research:stage": "node scripts/quality-controller.mjs research-stage",
    "quality:research:approve": "node scripts/quality-controller.mjs research-approve",
    "quality:gate": "node scripts/quality-controller.mjs gate",
    "quality:dagger": "node scripts/dagger-quality.mjs",
    "quality:test": "node --test scripts/opencode-routing.test.mjs scripts/opencode-tooling.test.mjs scripts/artifacts/*.test.mjs scripts/quality-lib.test.mjs scripts/quality-mcp/*.test.mjs scripts/quality/*.test.mjs scripts/github/*.test.mjs docker/agent-gateway/*.test.mjs docker/notion-publisher/*.test.mjs scripts/lab/*.test.mjs scripts/opencode-tui-merge.test.mjs scripts/opencode-preferences.test.mjs",
    "quality:eval:test": "uv run --project quality/inspect python -m unittest discover -s quality/inspect/tests -p 'test_*.py'",
    "quality:eval": "uv run --project quality/inspect inspect eval quality/inspect/evals/agent_quality.py --log-dir quality/inspect/logs --max-retries 2 --timeout 120 --time-limit 180 --max-tokens 2000 --max-connections 4 -M responses_api=false -M background=false",
    "quality:eval:trajectory": "uv run --project quality/inspect inspect eval quality/inspect/evals/trajectory_quality.py --log-dir quality/inspect/logs --max-retries 2 --timeout 120 --time-limit 180 --max-tokens 2000 --max-connections 4 -M responses_api=false -M background=false",
    "provenance:generate": "node scripts/release/provenance.mjs generate",
    "provenance:check": "node scripts/release/provenance.mjs check",
    "release:export": "node scripts/release/export-public-tree.mjs",
    "release:test": "node --test scripts/release/*.test.mjs",
    "secrets:history": "node scripts/release/scan-history.mjs",
    "format": "oxfmt --write .",
    "lint": "oxlint scripts/ docker/",
    "check": "oxfmt --check . && npm run test:lab && npm run quality:test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dagger.io/dagger": "0.21.8",
    "@open-pets/cli": "3.3.0",
    "@types/node": "^26.0.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
