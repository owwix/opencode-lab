{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/owwix/opencode-lab/main/schemas/project-v1.schema.json",
  "title": "OpenCode Lab project contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "install",
    "verify",
    "development",
    "previewPorts",
    "artifactRoots",
    "riskLevel",
    "enabledPacks"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/owwix/opencode-lab/main/schemas/project-v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "install": { "$ref": "#/$defs/commands" },
    "verify": { "$ref": "#/$defs/commands" },
    "development": { "$ref": "#/$defs/commands" },
    "previewPorts": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "container", "host"],
        "properties": {
          "name": { "$ref": "#/$defs/identifier" },
          "container": { "enum": [3000, 3001] },
          "host": { "enum": [3100, 3101] }
        },
        "oneOf": [
          {
            "properties": {
              "container": { "const": 3000 },
              "host": { "const": 3100 }
            }
          },
          {
            "properties": {
              "container": { "const": 3001 },
              "host": { "const": 3101 }
            }
          }
        ]
      }
    },
    "artifactRoots": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "riskLevel": { "enum": ["low", "standard", "high"] },
    "enabledPacks": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[:\\\\])[^\\u0000\\r\\n]+$"
    },
    "commands": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/command" }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "argv"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\u0000\\r\\n]+$"
          },
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]{0,79}$"
            }
          ]
        },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "env": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^(?!.*(?:API_?KEY|CREDENTIAL|PASSWORD|PRIVATE_?KEY|SECRET|TOKEN))[A-Z_][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[^\\u0000\\r\\n]*$"
          }
        }
      }
    }
  }
}
